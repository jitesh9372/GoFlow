PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-app.vercel.app

# Firebase Admin SDK Configuration
# Option 1: Service Account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: Individual variables
FIREBASE_PROJECT_ID=goflow-mumbai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# In-memory mock fallback when Firebase is not yet configured (true/false)
ENABLE_MOCK_FALLBACK=true

# RailRadar Transit API Integration (Optional)
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in/v1
